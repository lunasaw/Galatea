[Unit]
Description=Ray Head Node
Documentation=https://docs.ray.io/en/latest/cluster/running-applications/job-submission/index.html
Wants=network-online.target
Requires=minio.service
After=network-online.target minio.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/ai/chenzhangyue/galatea-model/galatea
Environment="PATH=/data/miniconda3/envs/attend-ray-py312/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="RAY_CONDA_HOME=/data/miniconda3"
Environment="MLFLOW_TRACKING_URI=http://10.26.0.140:18103"
Environment="RAY_REDIS_ADDRESS=127.0.0.1:6379"
Environment="RAY_external_storage_namespace=galatea-dev"
# The project Conda YAMLs pin the approved mirror explicitly.  Conda 26 still
# consults the global ``defaults`` multichannel unless it is cleared, which
# would trigger an interactive Anaconda Terms-of-Service gate in Ray's
# non-interactive runtime-env agent.
Environment="CONDA_DEFAULT_CHANNELS="
Environment="CONDA_PKGS_DIRS=/data/miniconda3/pkgs"
Environment="PIP_CACHE_DIR=/var/cache/ray/pip"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 /var/cache/ray/pip
ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 /data/ai/ray
# GCS 18104 must stay outside the worker range; Redis independently uses 6379.
ExecStart=/data/miniconda3/envs/attend-ray-py312/bin/ray start --head --port=18104 --dashboard-host=0.0.0.0 --dashboard-port=8265 --node-ip-address=10.26.0.140 --min-worker-port=18200 --max-worker-port=18399 '--resources={"dev":4}' --temp-dir=/data/ai/ray --disable-usage-stats --block
# systemd stops only this unit's process group; a global ray stop would also
# target the existing business worker on this shared host.
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=45s
LimitNOFILE=1048576
KillMode=control-group
UMask=0027
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
