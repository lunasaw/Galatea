{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galatea.local/schemas/toy-lora-sample.schema.json",
  "title": "Synthetic Toy LoRA SFT sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "scenario_id", "messages", "metadata"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "scenario_id": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_label", "generator_version", "seed"],
      "properties": {
        "style_label": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "preprocessing_version": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "source": {"const": "synthetic"}
      }
    }
  }
}
