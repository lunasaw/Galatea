{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galatea.local/schemas/llm-baseline-run-manifest.schema.json",
  "title": "LLM inference baseline run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "project", "task", "inference_baseline_only", "dataset", "split", "fixture", "model", "environment", "resources", "generation", "code_revision", "config_digest", "idempotency_key"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "const": "llm-lora-playground"},
    "task": {"type": "string", "const": "inference_baseline"},
    "inference_baseline_only": {"type": "boolean", "const": true},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "source_sha256", "config_sha256", "pipeline_version"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "pipeline_version": {"type": "string", "minLength": 1}, "root_reference": {"type": "string", "minLength": 1}}},
    "split": {"type": "object", "additionalProperties": false, "required": ["strategy", "name", "manifest_sha256"], "properties": {"strategy": {"type": "string", "const": "chronological_session"}, "name": {"type": "string", "const": "validation"}, "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "session_count": {"type": "integer", "minimum": 0}, "candidate_count": {"type": "integer", "minimum": 0}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["count", "digest", "prompt_policy_version", "target_removed"], "properties": {"count": {"type": "integer", "const": 20}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "prompt_policy_version": {"type": "string", "minLength": 1}, "target_removed": {"type": "boolean", "const": true}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "dtype", "enable_thinking"], "properties": {"id": {"type": "string", "const": "Qwen/Qwen3.5-0.8B"}, "revision": {"type": "string", "minLength": 1}, "dtype": {"type": "string", "const": "bfloat16"}, "enable_thinking": {"type": "boolean", "const": false}}},
    "environment": {"type": "object"},
    "resources": {"type": "object", "additionalProperties": false, "required": ["num_gpus", "num_cpus", "device"], "properties": {"num_gpus": {"type": "number", "const": 1}, "num_cpus": {"type": "number", "minimum": 1}, "device": {"type": "string", "const": "cuda:0"}}},
    "generation": {"type": "object"},
    "code_revision": {"type": "string", "minLength": 1},
    "config_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mlflow_run_id": {"type": ["string", "null"]}
  }
}
