[Unit]
Description=Independent Galatea governed training MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=galatea-mcp
Group=galatea-mcp
WorkingDirectory=/var/lib/galatea-mcp
EnvironmentFile=/etc/galatea-mcp/service.env
ExecStart=/opt/galatea-mcp/bin/galatea-mcp --config /etc/galatea-mcp/config.json serve --transport http
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/galatea-mcp

[Install]
WantedBy=multi-user.target
