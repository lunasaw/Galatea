{
  "schema_version": "galatea.deployment/v1",
  "state_root": "/var/lib/galatea-mcp",
  "registry_path": "/etc/galatea-mcp/projects.json",
  "principal": {
    "principal_id": "training-agent",
    "project_ids": ["ray-tabular-regression"],
    "campaign_ids": ["tabular-regression-example"],
    "actions": ["*"]
  },
  "http_port": 8791,
  "token_env": "GALATEA_SERVICE_TOKEN",
