[Unit]
Description=Independent Galatea Codex campaign runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=training-agent
Group=training-agent
WorkingDirectory=/var/lib/training-agent
EnvironmentFile=/etc/training-agent/runtime.env
ExecStart=/opt/training-agent/bin/training-agent --config /etc/training-agent/config.json run
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/training-agent

[Install]
WantedBy=multi-user.target
